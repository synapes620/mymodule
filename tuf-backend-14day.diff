+      }
+      return 1;
+    }
+    if (this.skipDepth === 0 && isNumberStart(c)) {
+      this.inNumber = true;
+      this.token = c;
+      return 1;
+    }
+    if (this.skipDepth === 0 && isIdentStart(c)) {
+      this.inIdent = true;
+      this.token = c;
+      return 1;
+    }
+    return 1;
+  }
