+  private finishSettings(): void {
+    const parsed = parseSettingsBlob(this.settingsBuf);
+    if (parsed) {
+      pickSettingsFromObject(parsed, this.settings);
+    } else {
+      extractSettingsLoose(this.settingsBuf, this.settings);
+    }
+    this.settingsBuf = '';
