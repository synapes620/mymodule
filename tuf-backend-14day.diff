+    }
+  }
+
+  private markDone(): void {
+    this.done = true;
+    this.phase = 'afterValue';
+  }
+
+  private flushEof(): void {
+    if (this.inNumber) this.finishNumber();
+    if (this.inIdent) this.finishIdent();
