+  private stepSettings(c: string): number {
+    this.settingsBuf += c;
+    if (c === '"' || c === "'") {
+      this.inString = true;
+      this.stringQuote = c;
+      this.escaped = false;
+      return 1;
+    }
+    if (c === '{') {
+      this.settingsDepth++;
+      return 1;
+    }
+    if (c === '}') {
+      this.settingsDepth--;
+      if (this.settingsDepth === 0) {
+        this.finishSettings();
+      }
+      return 1;
+    }
+    return 1;
+  }
