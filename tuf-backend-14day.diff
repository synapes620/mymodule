+export type InitializeElasticsearchResult = {
+  reindexedLevels: boolean;
+  reindexedPasses: boolean;
+  reindexedPlayers: boolean;
+  reindexedCreators: boolean;
+  reindexedMods: boolean;
+  reindexedTournaments: boolean;
+};
